{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-livery.invalid/schemas/livery.schema.json",
  "title": "DSH Livery manifest (schemaVersion 1)",
  "description": "Strict manifest contract for a built-in or custom DSH Livery. A manifest may only reference registered fonts, metrics, layout recipes and capability ids; it can never carry selectors, arbitrary CSS, remote URLs or font faces. Colours are four OKLab seeds per mode plus an optional whitelist token override map. Compilation, derivation and auditing happen outside the manifest.",
  "$comment": "additionalProperties:false is deliberate at every object level: unknown fields are rejected by the compiler, not ignored.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "meta",
    "variants",
    "typography",
    "layout",
    "compat"
  ],
  "properties": {
    "schemaVersion": {
      "description": "Manifest schema version. Only version 1 exists.",
      "const": 1
    },
    "id": {
      "description": "Stable livery id, also used as the body[data-dsh-livery] value and preview filename stem.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}$"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "tags",
        "order"
      ],
      "properties": {
        "name": {
          "description": "Display name, written natively in both locales.",
          "$ref": "#/$defs/localizedName"
        },
        "description": {
          "description": "One-sentence description, written natively in both locales.",
          "$ref": "#/$defs/localizedDescription"
        },
        "tags": {
          "description": "Stable tag ids from the core tag registry (src/core/registry.ts TAGS). Display labels live in i18n, never in the manifest.",
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/tagId"
          }
        },
        "order": {
          "description": "Gallery sort order within the built-in set.",
          "type": "integer",
          "minimum": 1,
          "maximum": 9999
        }
      }
    },
    "variants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "light",
        "dark"
      ],
      "properties": {
        "light": {
          "$ref": "#/$defs/variant"
        },
        "dark": {
          "$ref": "#/$defs/variant"
        }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ui",
        "content",
        "code",
        "metrics"
      ],
      "properties": {
        "ui": {
          "description": "Font registry id per locale for UI chrome (menus, buttons, labels).",
          "$ref": "#/$defs/fontRecord"
        },
        "content": {
          "description": "Font registry id per locale for conversation content.",
          "$ref": "#/$defs/fontRecord"
        },
        "code": {
          "description": "Font registry id for code, paths, ids and logs (shared by both locales).",
          "$ref": "#/$defs/fontId"
        },
        "metrics": {
          "description": "Typography metrics profile per locale.",
          "$ref": "#/$defs/metricsRecord"
        }
      }
    },
    "layout": {
      "description": "Registered layout recipes only; manifests never carry selectors or lengths.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "density",
        "conversationWidth",
        "messageFlow",
        "surfaceStyle"
      ],
      "properties": {
        "density": {
          "$ref": "#/$defs/densityId"
        },
        "conversationWidth": {
          "$ref": "#/$defs/conversationWidthId"
        },
        "messageFlow": {
          "$ref": "#/$defs/messageFlowId"
        },
        "surfaceStyle": {
          "$ref": "#/$defs/surfaceStyleId"
        }
      }
    },
    "compat": {
      "description": "Capability declaration. A missing required capability makes the livery unavailable; a missing optional capability is degraded with a documented fallback.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredCapabilities",
        "optionalCapabilities"
      ],
      "properties": {
        "requiredCapabilities": {
          "$ref": "#/$defs/capabilityList"
        },
        "optionalCapabilities": {
          "$ref": "#/$defs/capabilityList"
        }
      }
    }
  },
  "$defs": {
    "localeId": {
      "type": "string",
      "enum": [
        "zh-CN",
        "en-US"
      ]
    },
    "localizedName": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zh-CN",
        "en-US"
      ],
      "properties": {
        "zh-CN": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "en-US": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        }
      }
    },
    "localizedDescription": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zh-CN",
        "en-US"
      ],
      "properties": {
        "zh-CN": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "en-US": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        }
      }
    },
    "tagId": {
      "type": "string",
      "enum": [
        "calm",
        "cool",
        "warm",
        "neutral",
        "deep",
        "elegant",
        "playful",
        "contrast",
        "muted",
        "classic",
        "retro",
        "paper",
        "ink",
        "neon",
        "organic",
        "tech"
      ]
    },
    "hexColor": {
      "description": "Six-digit sRGB seed colour, e.g. #5b7c99.",
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "seeds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accent",
        "secondary",
        "surface",
        "text"
      ],
      "properties": {
        "accent": {
          "$ref": "#/$defs/hexColor"
        },
        "secondary": {
          "$ref": "#/$defs/hexColor"
        },
        "surface": {
          "$ref": "#/$defs/hexColor"
        },
        "text": {
          "$ref": "#/$defs/hexColor"
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seeds"
      ],
      "properties": {
        "seeds": {
          "$ref": "#/$defs/seeds"
        },
        "tokens": {
          "description": "Optional explicit token overrides; restricted to host-declared alias/specific tokens and safe CSS colour expressions. No selectors, no url(), no @-rules, no braces/semicolons.",
          "type": "object",
          "maxProperties": 128,
          "propertyNames": {
            "pattern": "^--dsw-(alias|specific)-[a-z0-9-]+$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/safeCssColor"
          }
        }
      }
    },
    "safeCssColor": {
      "description": "Safe CSS colour expression. The general manifestation of \"no CSS strings\": no selector/rule syntax, no url(), no @-rule, no markup.",
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?![\\s\\S]*(?:url\\s*\\(|@import|@font-face|@supports|@layer|expression\\s*\\(|javascript:|vbscript:|data:|https?:|file:|;|\\{|\\}|<|>))[\\s\\S]+$"
    },
    "fontId": {
      "description": "Registered local-only font stack id (src/core/registry.ts FONT_STACKS). Raw font stacks, @font-face, remote files and bundled fonts are rejected; new style-system ids are local system stacks with generic fallbacks.",
      "type": "string",
      "enum": [
        "system-cjk",
        "system-latin",
        "system-mono",
        "serif-cjk",
        "serif-latin",
        "humanist-cjk",
        "humanist-latin",
        "display-latin",
        "rounded-latin",
        "tech-latin"
      ]
    },
    "fontRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zh-CN",
        "en-US"
      ],
      "properties": {
        "zh-CN": {
          "$ref": "#/$defs/fontId"
        },
        "en-US": {
          "$ref": "#/$defs/fontId"
        }
      }
    },
    "metricsId": {
      "description": "Registered typography metrics profile id (src/core/registry.ts METRICS). Profiles may carry mode-independent consumed-font-token overrides (sizes/line-heights); manifests only reference the id.",
      "type": "string",
      "enum": [
        "cjk-comfortable",
        "latin-default",
        "comfortable",
        "compact",
        "airy",
        "editorial",
        "punchy",
        "technical",
        "quiet"
      ]
    },
    "metricsRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zh-CN",
        "en-US"
      ],
      "properties": {
        "zh-CN": {
          "$ref": "#/$defs/metricsId"
        },
        "en-US": {
          "$ref": "#/$defs/metricsId"
        }
      }
    },
    "densityId": {
      "type": "string",
      "enum": [
        "host",
        "compact",
        "comfortable"
      ]
    },
    "conversationWidthId": {
      "type": "string",
      "enum": [
        "host",
        "focused",
        "wide"
      ]
    },
    "messageFlowId": {
      "type": "string",
      "enum": [
        "stock",
        "separated"
      ]
    },
    "surfaceStyleId": {
      "type": "string",
      "enum": [
        "solid",
        "soft",
        "glass",
        "flat",
        "sharp",
        "rounded",
        "paper",
        "elevated",
        "terminal"
      ],
      "description": "Registered surface-style recipe id (src/core/registry.ts SurfaceStyleDefinitions). The manifest never carries radii/shadows/tokens for the style; only the registered id."
    },
    "capabilityId": {
      "type": "string",
      "enum": [
        "theme-css",
        "host-font-family",
        "host-density-tokens",
        "host-transcript-width",
        "host-message-flow",
        "surface-material",
        "reduced-transparency",
        "forced-colors",
        "reduced-motion"
      ]
    },
    "capabilityList": {
      "type": "array",
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/capabilityId"
      }
    }
  }
}
