{
  "name": "dsh-livery",
  "version": "0.1.2",
  "description": "Make your DSH beautiful to look at and alive to use. Contract-bound color, typography, surface and wallpaper liveries for DeepSeek Harness.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/previews",
    "cordis.patch.yml",
    "schemas",
    "liveries",
    "README.md",
    "README.zh-CN.md",
    "NOTICE.md",
    "LICENSE",
    "SECURITY.md",
    "SUPPORT.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CONTRIBUTING.zh-CN.md",
    "CODE_OF_CONDUCT.md",
    "docs",
    "contracts/dsh/0.2.0-rc.2",
    "contracts/dsh/0.2.1-rc.2",
    "contracts/dsh/0.2.1-rc.3",
    "contracts/dsh/support-matrix.json",
    "contracts/dsh/support-matrix.proposed.json"
  ],
  "sideEffects": [
    "./lib/index.js",
    "./lib/client.js"
  ],
  "engines": {
    "node": "^22.23.1 || ^24.21.0",
    "dsh": "0.2.1-rc.2 || 0.2.1-rc.3",
    "pnpm": ">=12"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "livery",
    "design-tokens",
    "oklab",
    "skin"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": [],
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.3": "compatible"
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "contract:snapshot": "node scripts/cli.mjs contract:snapshot",
    "contract:verify": "node scripts/cli.mjs contract:verify",
    "contract:diff": "node scripts/cli.mjs contract:diff",
    "adapter:generate": "node scripts/cli.mjs adapter:generate",
    "adapter:check": "node scripts/cli.mjs adapter:check",
    "test:loader-abi": "node scripts/cli.mjs test:loader-abi",
    "liveries:compile": "node scripts/cli.mjs liveries:compile",
    "liveries:check": "node scripts/cli.mjs liveries:check",
    "audit:tokens": "node scripts/cli.mjs audit:tokens",
    "audit:css": "node scripts/cli.mjs audit:css",
    "audit:contrast": "node scripts/cli.mjs audit:contrast",
    "pack:check": "node scripts/cli.mjs pack:check",
    "smoke:profile": "node scripts/cli.mjs smoke:profile",
    "test:runtime:web": "node scripts/cli.mjs test:runtime:web",
    "gate:support-matrix": "node scripts/cli.mjs gate:support-matrix",
    "gate:release": "node scripts/cli.mjs gate:release",
    "acceptance:web": "node scripts/acceptance/web.mjs",
    "verify": "pnpm typecheck && pnpm build && pnpm test && pnpm liveries:check && pnpm audit:css && pnpm audit:contrast && pnpm pack:check",
    "test:client": "vitest run tests/client",
    "test:host": "vitest run tests/host",
    "contract:regenerate": "node scripts/cli.mjs contract:regenerate",
    "contract:extract-desktop": "node scripts/prepare-desktop-contract.mjs",
    "test:browser": "node tests/browser/run.mjs",
    "release:check": "pnpm build:cli && node scripts/cli.mjs gate:support-matrix -- --all && node scripts/cli.mjs gate:release -- --all && node scripts/release-check.mjs",
    "prepublishOnly": "node scripts/prepublish-check.mjs",
    "pack:candidate": "node scripts/release-check.mjs",
    "verify:artifact": "node scripts/release-check.mjs",
    "verify:evidence": "node scripts/release-evidence.mjs",
    "promote:release": "node scripts/promote-release.mjs",
    "release:prepare": "pnpm release:check && node scripts/release-evidence.mjs --tgz .tmp/release-check/dsh-livery-0.1.2.tgz --evidence contracts/dsh/evidence/0.2.1-rc.2-web-chrome.json && node scripts/release-evidence.mjs --tgz .tmp/release-check/dsh-livery-0.1.2.tgz --evidence contracts/dsh/evidence/0.2.1-rc.3-desktop-macos.json",
    "build:cli": "node scripts/build.mjs --cli-only"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-theme": "0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@deepseek-ai/dsh-package-manifest": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.7",
    "ajv": "^8.17.1",
    "esbuild": "0.25.10",
    "playwright-core": "^1.55.0",
    "postcss": "^8.5.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  },
  "author": "DSH Livery contributors",
  "private": false,
  "publishConfig": {
    "access": "public"
  }
}
